local function selectTab(name)
    for n, page in pairs(pages) do
        page.Visible = (n == name)
        tabButtons[n].TextColor3 = (n == name) and THEME.text or THEME.textDim
        tabButtons[n].BackgroundColor3 = (n == name) and THEME.cardHover or Color3.new(1,1,1)
        tabButtons[n].BackgroundTransparency = (n == name) and 0 or 1
    end
    local btn = tabButtons[name]
    if btn and tabIndicator then
        tabIndicator.Size = UDim2.new(0, btn.AbsoluteSize.X - 8, 0, 2)
        tabIndicator.Position = UDim2.new(0, btn.AbsolutePosition.X - tabBar.AbsolutePosition.X + 4, 1, -2)
    end
end

local function makeTab(name)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 84, 1, -2)
