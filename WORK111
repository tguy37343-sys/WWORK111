local rPress, DRAG_THRESHOLD = nil, 6
restore.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        rPress = { startPos = input.Position, iconStart = restore.Position, moved = false }
    end
end)
UIS.InputChanged:Connect(function(input)
    if not rPress then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - rPress.startPos
        if not rPress.moved and d.Magnitude > DRAG_THRESHOLD then rPress.moved = true end
        if rPress.moved then
            restore.Position = UDim2.new(
                rPress.iconStart.X.Scale, rPress.iconStart.X.Offset + d.X,
                rPress.iconStart.Y.Scale, rPress.iconStart.Y.Offset + d.Y
            )
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if not rPress then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local wasClick = not rPress.moved
        rPress = nil
        if wasClick then setMinimized(false) end
    end
end)

local dragging, dragStart, startPos
main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mp = UIS:GetMouseLocation()
        if mp.Y - main.AbsolutePosition.Y <= 48 then
            dragging = true
            dragStart = Vector2.new(mp.X, mp.Y)
            startPos = Vector2.new(main.Position.X.Offset, main.Position.Y.Offset)
        end
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local mp = UIS:GetMouseLocation()
        local d = Vector2.new(mp.X, mp.Y) - dragStart
        main.Position = UDim2.new(0, startPos.X + d.X, 0, startPos.Y + d.Y)
        glowFrame.Position = UDim2.new(0, startPos.X + d.X - 8, 0, startPos.Y + d.Y - 8)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

